DATABASE_URL=
APP_URL=http://localhost:3000
AUTH_SECRET=
DASHBOARD_PASSWORD=
CRON_SECRET=

# Vaani
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=
VAANI_AGENT_ID=
VAANI_SIGNATURE_HEADER=x-webhook-signature

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# HubSpot (private app token; scopes: crm.objects.contacts/deals read+write, crm.schemas.deals write)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_URL=https://app.hubspot.com
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
HUBSPOT_STAGE_RECHECK=appointmentscheduled

# Email: either Resend (needs a verified domain) or Gmail SMTP (needs a Google app password). EMAIL_PROVIDER=resend|gmail (auto-detected if unset)
EMAIL_PROVIDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend / Telegram
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <leads@yourdomain.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=

# Cal.com (meeting bookings). CALENDAR_PROVIDER=calcom|google (auto: Cal.com if CALCOM_API_KEY is set)
# CALENDAR_PROVIDER=none -> the Vaani agent books live in Cal.com; this app only records the agreed time (no second booking)
CALENDAR_PROVIDER=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_FALLBACK_EMAIL=
CALCOM_API_VERSION=2026-02-25

# Google Calendar (OAuth refresh token of the account that owns the calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Assignment: round_robin | least_loaded
ASSIGNMENT_STRATEGY=round_robin
