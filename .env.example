DATABASE_URL=
APP_URL=http://localhost:3000
AUTH_SECRET=
DASHBOARD_PASSWORD=
CRON_SECRET=

# Vaani
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=
VAANI_AGENT_ID=
VAANI_SIGNATURE_HEADER=x-webhook-signature

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# HubSpot (private app token; scopes: crm.objects.contacts/deals read+write, crm.schemas.deals write)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_URL=https://app.hubspot.com
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
HUBSPOT_STAGE_RECHECK=appointmentscheduled

# Resend / Telegram
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <leads@yourdomain.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=

# Google Calendar (OAuth refresh token of the account that owns the calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Assignment: round_robin | least_loaded
ASSIGNMENT_STRATEGY=round_robin
